modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"

[deployment.build]
args = ["pnpm", "--filter", "@workspace/db", "run", "push"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-quality"

[[workflows.workflow]]
name = "workspace-quality"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck && pnpm test && pnpm run build"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
VITE_API_BASE_URL = "https://workspaceapi-server-production-cbfc.up.railway.app"
WFM_E2E_EMAIL = "deandredavis.biz@gmail.com"

[userenv.production]
VITE_API_BASE_URL = "https://workspaceapi-server-production-cbfc.up.railway.app"
